# Copie ce fichier en ".env" en local (jamais commité) et remplis les valeurs.
# Sur Railway : mets ces mêmes variables dans l'onglet "Variables" du service.

DISCORD_TOKEN=colle_ton_token_ici
CLIENT_ID=id_de_ton_application_discord

# Optionnel : ID d'un serveur précis pour enregistrer les slash commands instantanément
# (pratique en dev, sinon l'enregistrement global met jusqu'à 1h à se propager)
GUILD_ID=

# Nom affiché en bas de l'embed du panneau (ex: "by @tonpseudo.")
CREDIT_FOOTER=by @tonpseudo.
